{
  "name": "gestion-tienda-pro",
  "version": "7.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,svelte,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,svelte,css}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "dexie": "^4.0.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-svelte": "^0.460.0",
    "mode-watcher": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-svelte": "^2.46.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-eslint-parser": "^0.43.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json}": [
      "prettier --write"
    ]
  }
}
